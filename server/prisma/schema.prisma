generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @unique @db.VarChar(100)
  first_name   String?     @db.VarChar(50)
  last_name    String?     @db.VarChar(50)
  email        String      @unique @db.VarChar(255)
  password     String
  profile_img  String?     @db.VarChar(512)
  dob          DateTime?   @db.Date
  bio          String?
  created_at   DateTime    @default(now())
  updated_at   DateTime?
  is_deleted   Boolean?    @default(false)
  language     String?     @default("en")
  region       String      @default("global")
  created_pins pin[]       @relation("createdPins")
  saved_pins   saved_pin[] @relation("SavedPins")
  created_tags tag[]       @relation("UserCreatedTags")
  user_tags    user_tags[]

  @@map("users")
}

model pin {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(200)
  description String?
  image_url   String      @db.VarChar(512)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  is_deleted  Boolean?    @default(false)
  user_id     String      @db.Uuid
  pin_tags    pin_tags[]
  user        user        @relation("createdPins", fields: [user_id], references: [id])
  saved_by    saved_pin[] @relation("pinSavedByUsers")

  @@index([user_id])
  @@index([created_at])
  @@map("pins")
}

model tag {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique @db.VarChar(100)
  slug          String      @unique @db.VarChar(100)
  created_at    DateTime    @default(now())
  updated_at    DateTime?   @updatedAt
  created_by_id String      @db.Uuid
  pin_tags      pin_tags[]
  created_by    user        @relation("UserCreatedTags", fields: [created_by_id], references: [id])
  user_tags     user_tags[]

  @@index([name])
  @@index([slug])
  @@map("tags")
}

model saved_pin {
  user_id    String   @db.Uuid
  pin_id     String   @db.Uuid
  created_at DateTime @default(now())
  pin        pin      @relation("pinSavedByUsers", fields: [pin_id], references: [id])
  user       user     @relation("SavedPins", fields: [user_id], references: [id])

  @@id([user_id, pin_id])
  @@index([created_at])
  @@map("saved_pins")
}

model user_tags {
  user_id    String   @db.Uuid
  tag_id     String   @db.Uuid
  is_deleted Boolean? @default(false)
  tag        tag      @relation(fields: [tag_id], references: [id])
  user       user     @relation(fields: [user_id], references: [id])

  @@id([user_id, tag_id])
  @@map("user_tags")
}

model pin_tags {
  pin_id String @db.Uuid
  tag_id String @db.Uuid
  pin    pin    @relation(fields: [pin_id], references: [id])
  tag    tag    @relation(fields: [tag_id], references: [id])

  @@id([pin_id, tag_id])
  @@map("pin_tags")
}
